{
  "name": "gloss",
  "description": "Chrome extension that personalizes any website with a floating orb.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "playground": "vite --config playground/vite.config.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
